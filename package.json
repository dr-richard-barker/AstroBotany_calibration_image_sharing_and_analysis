{
  "name": "astrobotany-calibration-image-db",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Community database for sharing images of organisms and science alongside the AstroBotany calibration marker, with on-device metadata capture, compression, and client-side marker analysis.",
  "scripts": {
    "dev": "tsx server.ts",
    "seed": "tsx scripts/seed.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "clean": "rm -rf dist data",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "js-aruco2": "^2.0.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
